{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/acoi/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    }
  ],
  "redirects": [
    { "source": "/bitacora", "destination": "/blog/", "permanent": true },
    { "source": "/bitacora/", "destination": "/blog/", "permanent": true },
    { "source": "/bitacora/:path*", "destination": "/blog/:path*", "permanent": false },
    { "source": "/", "has": [{ "type": "host", "value": "bitacora.promii.co" }], "destination": "https://blog.promii.co/", "permanent": true },
    { "source": "/:path*", "has": [{ "type": "host", "value": "bitacora.promii.co" }], "destination": "https://blog.promii.co/:path*", "permanent": true },
    { "source": "/", "has": [{ "type": "host", "value": "comunidad.promii.co" }], "destination": "https://community.promii.co/", "permanent": true },
    { "source": "/", "has": [{ "type": "host", "value": "community.promii.co" }], "destination": "https://promii.co/#ecosistema", "permanent": false }
  ],
  "rewrites": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "editorial.promii.co" }], "destination": "/editorial/:path*" },
    { "source": "/:path*", "has": [{ "type": "host", "value": "archikatz.promii.co" }], "destination": "/editorial/:path*" },
    { "source": "/:path*", "has": [{ "type": "host", "value": "blog.promii.co" }], "destination": "/blog/:path*" },
    { "source": "/:path*", "has": [{ "type": "host", "value": "acoi.promii.co" }], "destination": "/acoi/:path*" },
    { "source": "/:path*", "has": [{ "type": "host", "value": "academy.promii.co" }], "destination": "/academy/:path*" },
    { "source": "/:path*", "has": [{ "type": "host", "value": "lab.promii.co" }], "destination": "/lab/:path*" },
    { "source": "/:path*", "has": [{ "type": "host", "value": "games.promii.co" }], "destination": "/games/:path*" },
    { "source": "/:path*", "has": [{ "type": "host", "value": "home.promii.co" }], "destination": "/home/:path*" },
    { "source": "/:path*", "has": [{ "type": "host", "value": "admin.promii.co" }], "destination": "/admin/:path*" },
    { "source": "/:path*", "has": [{ "type": "host", "value": "app.promii.co" }], "destination": "/home/:path*" },
    { "source": "/:path*", "has": [{ "type": "host", "value": "music.promii.co" }], "destination": "/lab/:path*" }
  ]
}
