{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "admin.promii.co"
        }
      ],
      "destination": "/admin/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "bitacora.promii.co"
        }
      ],
      "destination": "https://promii.co/bitacora/",
      "permanent": false
    },
    {
      "source": "/:path+",
      "has": [
        {
          "type": "host",
          "value": "bitacora.promii.co"
        }
      ],
      "destination": "https://promii.co/bitacora/:path+",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "lab.promii.co"
        }
      ],
      "destination": "https://promii.co/lab/",
      "permanent": false
    },
    {
      "source": "/:path+",
      "has": [
        {
          "type": "host",
          "value": "lab.promii.co"
        }
      ],
      "destination": "https://promii.co/lab/:path+",
      "permanent": false
    },
    {
